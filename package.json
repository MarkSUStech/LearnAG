{
  "name": "learn-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基于 Markdown 编辑器的学习 Agent 网页软件",
  "scripts": {
    "test:agent": "node --test scripts/test-agent-efficiency.mjs",
    "test:images": "node --test scripts/test-images.mjs scripts/test-image-sources.mjs",
    "test:noteui": "node --test scripts/test-noteui.mjs scripts/test-noteui-interactive.mjs scripts/test-noteui-system.mjs",
    "dev": "concurrently -k -n server,web -c blue,green \"node server/index.js\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@milkdown/crepe": "^7.22.1",
    "@terrastruct/d2": "^0.1.33",
    "@xmldom/xmldom": "^0.9.12",
    "beautiful-mermaid": "^1.1.3",
    "chokidar": "^3.6.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.14",
    "express": "^4.21.2",
    "gnuplot-wasm": "^0.1.0",
    "katex": "^0.18.4",
    "marked": "^18.0.11",
    "material-symbols": "^0.28.2",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^4.10.38",
    "pyright": "^1.1.413",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
